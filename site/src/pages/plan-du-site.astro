---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const [services, secteurs, cases, posts, zones] = await Promise.all([
  getCollection('services'),
  getCollection('secteurs'),
  getCollection('realisations'),
  getCollection('blog', ({ data }) => !data.draft),
  getCollection('zones'),
]);
const groups = [
  { t: 'Solutions', items: services.sort((a, b) => a.data.order - b.data.order).map((s) => ({ l: s.data.navLabel, h: `/${s.id}/` })) },
  { t: 'Secteurs', items: secteurs.sort((a, b) => a.data.order - b.data.order).map((s) => ({ l: s.data.navLabel, h: `/secteurs/${s.id}/` })) },
  { t: 'Réalisations', items: [{ l: 'Toutes les réalisations', h: '/realisations/' }, ...cases.map((c) => ({ l: c.data.title, h: `/realisations/${c.id}/` }))] },
  { t: 'Conseils', items: [{ l: 'Tous les articles', h: '/blog/' }, ...posts.map((p) => ({ l: p.data.title, h: `/blog/${p.id}/` }))] },
  { t: 'Zones', items: [{ l: 'Zones d’intervention', h: '/zones/' }, ...zones.map((z) => ({ l: z.data.name, h: `/zones/${z.id}/` }))] },
  {
    t: 'Entreprise',
    items: [
      { l: 'Demande d’estimation', h: '/devis/' },
      { l: 'Contact', h: '/contact/' },
      { l: 'À propos', h: '/a-propos/' },
      { l: 'Questions fréquentes', h: '/faq/' },
      { l: 'Partenaires', h: '/partenaires/' },
      { l: 'Recrutement', h: '/recrutement/' },
      { l: 'Mentions légales', h: '/mentions-legales/' },
      { l: 'Confidentialité', h: '/confidentialite/' },
    ],
  },
];
---
<BaseLayout title="Plan du site" description="Plan du site K Isolation : solutions, secteurs, réalisations, conseils, zones d'intervention et informations sur l'entreprise.">
  <section class="py-14 sm:py-20">
    <div class="container-k">
      <h1 class="h-section">Plan du site</h1>
      <div class="mt-10 grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
        {groups.map((g) => (
          <div>
            <h2 class="font-display text-lg font-bold text-ink">{g.t}</h2>
            <ul class="mt-3 space-y-2">{g.items.map((i) => <li><a href={i.h} class="text-steel-600 hover:text-brand-600">{i.l}</a></li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
