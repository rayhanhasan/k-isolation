---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/ui/Icon.astro';
import SectionHeading from '../components/sections/SectionHeading.astro';
import LogoWall from '../components/sections/LogoWall.astro';
import BeforeAfter from '../components/sections/BeforeAfter.astro';
import ProcessSteps from '../components/sections/ProcessSteps.astro';
import Guarantees from '../components/sections/Guarantees.astro';
import FaqList from '../components/sections/FaqList.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import CaseCard from '../components/cards/CaseCard.astro';
import ArticleCard from '../components/cards/ArticleCard.astro';
import { SITE, STATS } from '../data/site';
import { faqSchema } from '../lib/schema';

import heroImg from '../assets/chantiers/cuisine-pro-cloisons-inox.jpg';
import nightImg from '../assets/chantiers/magasin-couloir-panneaux.jpg';
import solAvant from '../assets/chantiers/sol-chambre-froide-avant.jpg';
import solApres from '../assets/chantiers/sol-chambre-froide-apres.jpg';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const secteurs = (await getCollection('secteurs')).sort((a, b) => a.data.order - b.data.order);
const cases = (await getCollection('realisations')).sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || +b.data.date - +a.data.date).slice(0, 3);
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) => +(b.data.updated ?? b.data.date) - +(a.data.updated ?? a.data.date)).slice(0, 3);

/** Choix guidé : on part de la situation du visiteur, pas de notre catalogue. */
const situations = [
  { icon: 'building', t: 'J’ouvre ou j’agrandis un site', d: 'Restaurant, labo, entrepôt, magasin : chambre froide et cloisons livrées pour votre date d’ouverture.', href: '/chambres-froides/', cta: 'Chambres froides & cloisons' },
  { icon: 'fileText', t: 'Un audit ou un contrôle approche', d: 'Murs abîmés, joints noircis, sol fissuré : on remet vos locaux au niveau HACCP / IFS sans fermer.', href: '/renovation-chambre-froide/', cta: 'Rénovation & conformité' },
  { icon: 'refresh', t: 'Mon installation vieillit', d: 'Panneaux percés, givre, portes fatiguées, sol qui se soulève : on rénove l’enveloppe en site occupé.', href: '/renovation-chambre-froide/', cta: 'Rénover sans arrêter' },
  { icon: 'alert', t: 'J’ai un problème maintenant', d: 'Porte qui ne ferme plus, panneau endommagé par un chariot : appelez, on organise l’intervention.', href: '/sav-maintenance/', cta: 'Dépannage prioritaire', urgent: true },
] as const;

const stakes = [
  { k: 'Un rayon fermé', v: 'c’est du chiffre d’affaires perdu chaque heure, et des clients qui vont voir ailleurs.' },
  { k: 'Un contrôle « à améliorer »', v: 'reste affiché publiquement pendant un an sur Alim’confiance.' },
  { k: 'Une rupture de froid', v: 'c’est un stock entier à détruire et des comptes à rendre à votre direction.' },
  { k: 'Une ouverture qui glisse', v: 'c’est un loyer qui court et une équipe payée sans recettes.' },
];

const faqs = [
  {
    q: 'Pouvez-vous vraiment travailler sans arrêter notre activité ?',
    a: 'Oui, c’est notre façon de travailler par défaut. Selon le site, nous intervenons **de nuit** (par exemple de 21 h à 6 h dans un magasin ouvert le jour), **le week-end** ou **par phases** : une partie de la chambre froide reste en service pendant que l’autre est traitée. Le phasage est écrit dans le devis avant signature.',
  },
  {
    q: 'Sous quel délai recevons-nous un devis ?',
    a: 'Vous recevez une **première estimation technique et budgétaire en moins d’un jour ouvré**. Si le projet le nécessite, une visite technique permet ensuite d’établir le devis détaillé poste par poste et le planning.',
  },
  {
    q: 'Vous réparez aussi le groupe froid ?',
    a: 'Notre métier, c’est **l’enveloppe** : panneaux, portes, joints, sols, cloisons et revêtements. Pour la production de froid (groupe, évaporateur, fluide), nous travaillons avec des frigoristes partenaires et coordonnons les deux interventions pour vous.',
  },
  {
    q: 'Intervenez-vous en dehors de Marseille ?',
    a: 'Nos équipes interviennent principalement en **région PACA** et en **Île-de-France** (référence au MIN de Rungis), et se déplacent partout en France pour les projets multi-sites. Les projets en Suisse et en Europe sont étudiés au cas par cas.',
  },
  {
    q: 'Quels documents recevons-nous à la fin du chantier ?',
    a: 'Un **procès-verbal de réception**, les fiches techniques des matériaux posés et les informations utiles à vos audits. Nos travaux sont couverts par une **garantie décennale** dont l’attestation accompagne le devis.',
  },
  {
    q: 'Vous êtes une structure à taille humaine : quel est le risque pour nous ?',
    a: 'C’est justement ce qui vous protège : le décideur est sur le terrain, il n’y a pas de sous-traitance en cascade et vous gardez le même interlocuteur de la visite au SAV. Nos engagements (planning, phasage, garanties) sont écrits, et notre dossier fournisseur est disponible pour vos achats.',
  },
];
---
<BaseLayout
  title="Chambres froides & cloisons isothermes, Marseille & IDF | K Isolation"
  description="Chambres froides, cloisons isothermes et rénovation pour la distribution, la restauration et l'agro. Chantiers de nuit ou phasés, estimation sous 24 h."
  headerOverlay
  schema={[faqSchema(faqs)]}
>
  <!-- ─────────────── 1. HERO : promesse + preuve immédiate ─────────────── -->
  <section class="relative isolate overflow-hidden bg-navy-950 pt-32 pb-14 text-white sm:pt-36 lg:pt-44 lg:pb-24">
    <div class="bg-blueprint absolute inset-0 -z-10" aria-hidden="true"></div>
    <div class="absolute top-0 right-0 -z-10 size-[50rem] translate-x-1/3 -translate-y-1/3 rounded-full bg-brand-600/20 blur-3xl" aria-hidden="true"></div>
    <div class="container-k grid items-center gap-12 lg:grid-cols-12">
      <div class="lg:col-span-6 xl:col-span-7">
        <p class="eyebrow-dark"><Icon name="snowflake" class="size-3.5" /> Grande distribution · Restauration · Agroalimentaire · Logistique</p>
        <h1 class="mt-5 font-display text-[2.35rem] leading-[1.04] font-extrabold tracking-tight sm:text-5xl xl:text-[3.6rem]">
          Chambres froides &amp; cloisons isothermes, posées <span class="relative whitespace-nowrap text-ice-300">sans arrêter<svg class="absolute -bottom-2 left-0 h-3 w-full text-brand-500" viewBox="0 0 200 12" preserveAspectRatio="none" aria-hidden="true"><path d="M2 9c40-6 120-8 196-3" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" /></svg></span> votre activité.
        </h1>
        <p class="mt-7 max-w-xl text-lg leading-relaxed text-steel-300 sm:text-xl">
          Création, rénovation et dépannage de l’enveloppe du froid&nbsp;: panneaux, portes, sols et cloisons. Chantiers de nuit, le week-end ou par phases&nbsp;: vos rayons restent ouverts, votre chaîne du froid reste intacte.
        </p>
        <div class="mt-9 flex flex-col flex-wrap gap-3 sm:flex-row">
          <a href="/devis/" data-loc="hero" class="btn-primary px-7 text-lg whitespace-nowrap">Mon estimation sous 24 h <Icon name="arrowRight" class="size-5" /></a>
          <a href={SITE.phoneHref} data-loc="hero" class="btn-ghost-dark whitespace-nowrap"><Icon name="phone" class="size-5" /> {SITE.phone}</a>
        </div>
        <p class="mt-4 text-sm text-steel-400">2 minutes · Sans engagement · Aucun démarchage · Urgence : appelez directement</p>
        <p class="mt-8 flex items-center gap-2 text-sm text-steel-400"><Icon name="mapPin" class="size-4 text-ice-400" /> Marseille, Île-de-France et partout en France pour vos sites multiples</p>
      </div>

      <div class="relative lg:col-span-6 xl:col-span-5">
        <div class="relative overflow-hidden rounded-3xl border border-white/10 shadow-2xl">
          <Image src={heroImg} alt="Cuisine professionnelle cloisonnée en panneaux isothermes blancs, équipements inox et gaines techniques, chantier réalisé par K Isolation" widths={[480, 720, 960, 1200]} sizes="(min-width: 1280px) 40vw, (min-width: 1024px) 48vw, 100vw" class="aspect-[16/10] w-full object-cover sm:aspect-[4/3] lg:aspect-[4/5]" loading="eager" fetchpriority="high" />
          <div class="absolute inset-0 bg-gradient-to-t from-navy-950/80 via-transparent to-transparent" aria-hidden="true"></div>
          <p class="absolute right-4 bottom-4 font-mono text-xs tracking-wider text-steel-300 uppercase">Chantier réel · cuisine pro</p>
        </div>
        <!-- Cartes de preuve flottantes -->
        <a href="/realisations/renovation-magasin-carrefour-lambris-pvc/" class="absolute -bottom-6 -left-4 hidden w-64 rounded-2xl border border-steel-200 bg-white p-4 text-ink shadow-lift transition hover:-translate-y-1 sm:block lg:-left-10">
          <p class="flex items-center gap-2 font-mono text-[0.7rem] tracking-wider text-brand-600 uppercase"><Icon name="clock" class="size-3.5" /> Hypermarché · de nuit</p>
          <p class="mt-1.5 text-[0.95rem] leading-snug font-semibold">320 m² rénovés de 21 h à 6 h, rayon frais ouvert chaque matin</p>
        </a>
        <a href="/realisations/depose-remplacement-sol-chambre-froide-negative/" class="absolute -top-6 -right-3 hidden w-60 rounded-2xl border border-white/15 bg-navy-900/90 p-4 shadow-lift backdrop-blur transition hover:-translate-y-1 sm:block lg:-right-6">
          <p class="flex items-center gap-2 font-mono text-[0.7rem] tracking-wider text-ice-300 uppercase"><Icon name="thermometer" class="size-3.5" /> Chambre négative</p>
          <p class="mt-1.5 text-[0.95rem] leading-snug font-semibold">Sol refait à −22 °C, 50 % du stockage maintenu</p>
        </a>
      </div>
    </div>
  </section>

  <!-- ─────────────── 2. Preuve sociale immédiate ─────────────── -->
  <section class="border-b border-steel-200 bg-white py-10" aria-label="Références clientes">
    <LogoWall />
  </section>

  <!-- ─────────────── 3. Choix guidé par situation ─────────────── -->
  <section class="py-20 sm:py-24">
    <div class="container-k">
      <SectionHeading eyebrow="Par où commencer" title="Quelle est votre situation&nbsp;?" lead="Choisissez ce qui vous ressemble : vous arrivez directement sur la réponse adaptée, avec les chantiers comparables." />
      <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {situations.map((s) => (
          <li class:list={['group card relative flex flex-col p-6 transition hover:-translate-y-1 hover:shadow-lift', 'urgent' in s && 'border-alert-600/30 bg-alert-50']}>
            <span class:list={['flex size-12 items-center justify-center rounded-xl', 'urgent' in s ? 'bg-alert-600 text-white' : 'bg-navy-900 text-ice-300']}><Icon name={s.icon} class="size-6" /></span>
            <h3 class="mt-5 text-lg leading-snug font-bold text-ink">{s.t}</h3>
            <p class="mt-2 flex-1 text-[0.95rem] leading-relaxed text-steel-600">{s.d}</p>
            <a href={s.href} class:list={['mt-5 inline-flex items-center gap-1.5 font-semibold after:absolute after:inset-0', 'urgent' in s ? 'text-alert-600' : 'text-brand-600']}>{s.cta} <Icon name="arrowRight" class="size-4 transition group-hover:translate-x-1" /></a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ─────────────── 4. Les enjeux (coût de l'inaction) ─────────────── -->
  <section class="bg-frost-100 py-20 sm:py-24">
    <div class="container-k grid items-center gap-12 lg:grid-cols-2">
      <div>
        <p class="eyebrow">Ce qui est en jeu</p>
        <h2 class="h-section mt-3">Le vrai coût d’un chantier, c’est rarement le devis.</h2>
        <p class="lead mt-5">C’est ce que le chantier vous fait perdre pendant qu’il dure. C’est pour ça que nous organisons les travaux autour de votre exploitation, et pas l’inverse.</p>
        <dl class="mt-8 divide-y divide-steel-300/70 border-y border-steel-300/70">
          {stakes.map((s) => (
            <div class="grid gap-1 py-4 sm:grid-cols-[13rem_1fr] sm:gap-6">
              <dt class="font-display font-bold text-ink">{s.k}</dt>
              <dd class="text-steel-600">{s.v}</dd>
            </div>
          ))}
        </dl>
      </div>
      <div class="relative">
        <Image src={nightImg} alt="Couloir de magasin habillé de panneaux blancs et protections, rénové par K Isolation" widths={[480, 720, 960]} sizes="(min-width: 1024px) 45vw, 100vw" class="aspect-[4/5] w-full rounded-3xl object-cover shadow-lift" />
        <div class="absolute right-4 bottom-4 left-4 rounded-2xl bg-navy-950/90 p-5 text-white backdrop-blur sm:right-auto sm:max-w-xs">
          <p class="font-mono text-xs tracking-wider text-ice-300 uppercase">Notre réponse</p>
          <p class="mt-2 font-semibold">Travaux de nuit, le week-end ou par phases, planifiés avec vous avant de signer.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ─────────────── 5. Preuves chiffrées ─────────────── -->
  <section class="py-20 sm:py-24">
    <div class="container-k">
      <SectionHeading eyebrow="Pourquoi nous" title="Trois preuves plutôt que trois promesses" />
      <div class="mt-12 grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <BeforeAfter before={solAvant} after={solApres} beforeAlt="Sol de chambre froide négative dégradé avant travaux : fissures et revêtement arraché" afterAlt="Sol de chambre froide négative refait, revêtement sombre continu et propre" />
          <p class="mt-3 text-sm text-steel-500">Glissez pour comparer : réfection d’un sol de chambre froide négative.</p>
        </div>
        <ol class="space-y-8 lg:col-span-5">
          <li class="flex gap-5">
            <span class="font-display text-4xl font-extrabold text-brand-600">1</span>
            <div>
              <h3 class="text-xl font-bold text-ink">Nous travaillons quand vous êtes fermés</h3>
              <p class="mt-2 text-steel-600">Hypermarché : 320 m² de lambris PVC alimentaire et de protections rénovés de 21 h à 6 h et le week-end, en 3 semaines. Le rayon frais a ouvert chaque matin, nettoyé.</p>
              <a href="/realisations/renovation-magasin-carrefour-lambris-pvc/" class="link-arrow mt-2 text-sm">Voir le chantier <Icon name="arrowRight" class="size-4" /></a>
            </div>
          </li>
          <li class="flex gap-5">
            <span class="font-display text-4xl font-extrabold text-brand-600">2</span>
            <div>
              <h3 class="text-xl font-bold text-ink">Nous ne coupons pas votre chaîne du froid</h3>
              <p class="mt-2 text-steel-600">Chambre froide à −22 °C : 180 m² de sol déposés et refaits en 2 phases et 10 jours ouvrés, 50 % de la capacité de stockage maintenue pendant tout le chantier.</p>
              <a href="/realisations/depose-remplacement-sol-chambre-froide-negative/" class="link-arrow mt-2 text-sm">Voir le chantier <Icon name="arrowRight" class="size-4" /></a>
            </div>
          </li>
          <li class="flex gap-5">
            <span class="font-display text-4xl font-extrabold text-brand-600">3</span>
            <div>
              <h3 class="text-xl font-bold text-ink">Un interlocuteur, des engagements écrits</h3>
              <p class="mt-2 text-steel-600">La même personne fait la visite, suit le chantier et reste votre contact SAV. Planning, phasage et garanties sont écrits dans le devis.</p>
            </div>
          </li>
        </ol>
      </div>
      <dl class="mt-16 grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-steel-200 bg-steel-200 lg:grid-cols-4">
        {STATS.map((s) => (
          <div class="bg-white p-6">
            <dt class="text-sm leading-snug text-steel-500">{s.label}</dt>
            <dd class="order-first font-display text-3xl font-extrabold text-ink sm:text-4xl">{s.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- ─────────────── 6. Solutions ─────────────── -->
  {services.length > 0 && (
    <section id="solutions" class="bg-frost-100 py-20 sm:py-24">
      <div class="container-k">
        <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-end">
          <SectionHeading eyebrow="Nos solutions" title="L’enveloppe du froid, de la pose au dépannage" lead="Nous concevons, posons, rénovons et entretenons tout ce qui garde votre froid à l’intérieur : panneaux, portes, sols, plafonds et cloisons." />
          <a href="/devis/" data-loc="solutions" class="btn-ghost shrink-0">Décrire mon projet</a>
        </div>
        <ul class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {services.map((s, i) => (
            <li class:list={['group card relative flex flex-col overflow-hidden transition hover:-translate-y-1 hover:shadow-lift', i === 0 && 'lg:row-span-2']}>
              <div class="overflow-hidden">
                <Image src={s.data.heroImage} alt={s.data.heroAlt} widths={[400, 640, 800]} sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw" class:list={['w-full object-cover transition duration-500 group-hover:scale-[1.03]', i === 0 ? 'aspect-[4/3] lg:aspect-[4/5]' : 'aspect-[16/9]']} />
              </div>
              <div class="flex flex-1 flex-col p-6">
                <h3 class="text-xl font-bold text-ink"><a href={`/${s.id}/`} class="after:absolute after:inset-0">{s.data.cardTitle}</a></h3>
                <p class="mt-2 flex-1 text-steel-600">{s.data.cardText}</p>
                <span class="link-arrow mt-4">En savoir plus <Icon name="arrowRight" class="size-4" /></span>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- ─────────────── 7. Méthode ─────────────── -->
  <ProcessSteps />

  <!-- ─────────────── 8. Secteurs ─────────────── -->
  {secteurs.length > 0 && (
    <section id="secteurs" class="py-20 sm:py-24">
      <div class="container-k">
        <SectionHeading eyebrow="Vos métiers" title="Nous connaissons vos contraintes avant d’arriver" lead="Audits d’enseigne, IFS, DDPP, dates d’ouverture, stocks sous température : chaque secteur a ses règles. Voici les vôtres." />
        <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {secteurs.map((s) => (
            <li class="group relative flex items-start gap-4 rounded-2xl border border-steel-200 p-5 transition hover:border-brand-500 hover:bg-frost-50">
              <span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-frost-100 text-brand-600 group-hover:bg-brand-600 group-hover:text-white"><Icon name={s.data.icon as any} class="size-5" /></span>
              <div>
                <h3 class="font-bold text-ink"><a href={`/secteurs/${s.id}/`} class="after:absolute after:inset-0">{s.data.navLabel}</a></h3>
                <p class="mt-1 text-sm leading-relaxed text-steel-600">{s.data.cardText}</p>
              </div>
            </li>
          ))}
        </ul>
        <p class="mt-8 text-steel-600">Vous êtes frigoriste, cuisiniste ou maître d’œuvre&nbsp;? <a href="/partenaires/" class="link-arrow">Confiez-nous le lot enveloppe <Icon name="arrowRight" class="size-4" /></a></p>
      </div>
    </section>
  )}

  <!-- ─────────────── 9. Réalisations ─────────────── -->
  {cases.length > 0 && (
    <section class="bg-frost-100 py-20 sm:py-24">
      <div class="container-k">
        <div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-end">
          <SectionHeading eyebrow="Réalisations" title="Des chantiers comme le vôtre" lead="Contexte, contraintes, phasage, résultat : chaque étude de cas raconte comment nous avons travaillé autour de l’exploitation du client." />
          <a href="/realisations/" class="link-arrow shrink-0">Toutes les réalisations <Icon name="arrowRight" class="size-4" /></a>
        </div>
        <div class="mt-12 grid gap-6 md:grid-cols-3">
          {cases.map((c) => <CaseCard entry={c} />)}
        </div>
      </div>
    </section>
  )}

  <!-- ─────────────── 10. Garanties ─────────────── -->
  <Guarantees />

  <!-- ─────────────── 11. Objections ─────────────── -->
  <div class="bg-frost-50">
    <FaqList faqs={faqs} />
  </div>

  <!-- ─────────────── 12. Conseils ─────────────── -->
  {posts.length > 0 && (
    <section class="py-20 sm:py-24">
      <div class="container-k">
        <div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-end">
          <SectionHeading eyebrow="Conseils d’experts" title="Préparez votre projet avec les bonnes questions" />
          <a href="/blog/" class="link-arrow shrink-0">Tous les conseils <Icon name="arrowRight" class="size-4" /></a>
        </div>
        <div class="mt-12 grid gap-10 md:grid-cols-3">
          {posts.map((p) => <ArticleCard entry={p} />)}
        </div>
      </div>
    </section>
  )}

  <!-- ─────────────── 13. Passage à l'action ─────────────── -->
  <CtaBand loc="accueil-fin" />
</BaseLayout>
