---
import { getCollection, getEntries, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import LogoWall from '../components/sections/LogoWall.astro';
import SectionHeading from '../components/sections/SectionHeading.astro';
import ProcessSteps from '../components/sections/ProcessSteps.astro';
import FaqList from '../components/sections/FaqList.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import CaseCard from '../components/cards/CaseCard.astro';
import Icon from '../components/ui/Icon.astro';
import { faqSchema, serviceSchema } from '../lib/schema';
import { inlineMd } from '../lib/inline-md';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((entry) => ({ params: { service: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content, headings } = await render(entry);
const cases = await getEntries(d.relatedCases);
const allServices = (await getCollection('services')).filter((s) => s.id !== entry.id).sort((a, b) => a.data.order - b.data.order);
const secteurs = (await getCollection('secteurs')).filter((s) => d.relatedSectors.includes(s.id));
const path = `/${entry.id}/`;
const breadcrumbs = [
  { name: 'Accueil', href: '/' },
  { name: d.navLabel, href: path },
];
const toc = headings.filter((h) => h.depth === 2);
const devisHref = `/devis/?besoin=${encodeURIComponent(d.devisPreset)}`;
---
<BaseLayout
  title={d.metaTitle}
  description={d.metaDescription}
  breadcrumbs={breadcrumbs}
  image={d.heroImage.src}
  schema={[serviceSchema({ name: d.navLabel, description: d.metaDescription, path }), faqSchema(d.faqs)]}
>
  <PageHero eyebrow={d.eyebrow} title={d.h1} lead={d.lead} image={d.heroImage} imageAlt={d.heroAlt} breadcrumbs={breadcrumbs} ctaHref={devisHref} ctaLabel="Obtenir ma première estimation" />

  <section class="border-b border-steel-200 py-8" aria-label="Références clientes"><LogoWall /></section>

  <!-- Situations déclenchantes : le visiteur se reconnaît -->
  <section class="py-16 sm:py-20">
    <div class="container-k grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="eyebrow">Pour qui</p>
        <h2 class="h-section mt-3">Vous êtes dans l’une de ces situations&nbsp;?</h2>
        <a href={devisHref} data-loc="service-situations" class="btn-primary mt-8">Décrire ma situation <Icon name="arrowRight" class="size-4" /></a>
      </div>
      <ul class="grid gap-3 lg:col-span-7">
        {d.triggers.map((t) => (
          <li class="flex items-start gap-4 rounded-2xl border border-steel-200 bg-white p-5">
            <span class="mt-0.5 flex size-7 shrink-0 items-center justify-center rounded-full bg-brand-100 text-brand-700"><Icon name="check" class="size-4" /></span>
            <span class="text-lg text-ink" set:html={inlineMd(t)} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Bénéfices -->
  <section class="bg-frost-100 py-16 sm:py-20">
    <div class="container-k">
      <SectionHeading eyebrow="Ce que vous obtenez" title="Concrètement, ce qui change pour vous" />
      <ul class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {d.benefits.map((b) => (
          <li class="card p-6">
            <h3 class="text-lg font-bold text-ink">{b.title}</h3>
            <p class="mt-2 leading-relaxed text-steel-600" set:html={inlineMd(b.text)} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Contenu expert + sommaire collant -->
  <section class="py-16 sm:py-20">
    <div class="container-k grid gap-12 lg:grid-cols-12">
      <aside class="lg:col-span-4">
        <div class="space-y-6 lg:sticky lg:top-28">
          {toc.length > 2 && (
            <nav aria-label="Sommaire" class="rounded-2xl border border-steel-200 p-5">
              <p class="font-mono text-xs tracking-wider text-steel-500 uppercase">Sommaire</p>
              <ol class="mt-3 space-y-2 text-[0.95rem]">
                {toc.map((h) => <li><a href={`#${h.slug}`} class="text-steel-600 hover:text-brand-600">{h.text}</a></li>)}
              </ol>
            </nav>
          )}
          {d.specs && d.specs.length > 0 && (
            <div class="rounded-2xl bg-navy-900 p-5 text-white">
              <p class="font-mono text-xs tracking-wider text-ice-300 uppercase">Repères techniques</p>
              <dl class="mt-3 divide-y divide-white/10">
                {d.specs.map((s) => (
                  <div class="flex justify-between gap-4 py-2.5 text-sm">
                    <dt class="text-steel-400">{s.label}</dt>
                    <dd class="text-right font-semibold">{s.value}</dd>
                  </div>
                ))}
              </dl>
            </div>
          )}
          <div class="rounded-2xl border border-brand-500/30 bg-brand-100/40 p-5">
            <p class="font-bold text-ink">Un projet, une question technique&nbsp;?</p>
            <p class="mt-1 text-sm text-steel-600">Première estimation en moins d’un jour ouvré.</p>
            <a href={devisHref} data-loc="service-aside" class="btn-primary mt-4 w-full">Demander mon estimation</a>
          </div>
        </div>
      </aside>
      <article class="prose-k lg:col-span-8">
        <Content />
      </article>
    </div>
  </section>

  <ProcessSteps />

  {cases.length > 0 && (
    <section class="py-16 sm:py-20">
      <div class="container-k">
        <SectionHeading eyebrow="Preuves" title="Chantiers réalisés" />
        <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {cases.map((c) => <CaseCard entry={c} />)}
        </div>
      </div>
    </section>
  )}

  <div class="bg-frost-50"><FaqList faqs={d.faqs} /></div>

  {(secteurs.length > 0 || allServices.length > 0) && (
    <section class="py-16">
      <div class="container-k grid gap-10 md:grid-cols-2">
        {secteurs.length > 0 && (
          <div>
            <p class="eyebrow">Secteurs concernés</p>
            <ul class="mt-4 flex flex-wrap gap-2">
              {secteurs.map((s) => <li><a href={`/secteurs/${s.id}/`} class="inline-flex rounded-full border border-steel-300 px-4 py-2 text-sm font-medium hover:border-brand-500 hover:text-brand-600">{s.data.navLabel}</a></li>)}
            </ul>
          </div>
        )}
        <div>
          <p class="eyebrow">Nos autres solutions</p>
          <ul class="mt-4 flex flex-wrap gap-2">
            {allServices.map((s) => <li><a href={`/${s.id}/`} class="inline-flex rounded-full border border-steel-300 px-4 py-2 text-sm font-medium hover:border-brand-500 hover:text-brand-600">{s.data.navLabel}</a></li>)}
          </ul>
        </div>
      </div>
    </section>
  )}

  <CtaBand title={d.ctaTitle} text={d.ctaText} preset={d.devisPreset} loc={`service-${entry.id}`} />
</BaseLayout>
