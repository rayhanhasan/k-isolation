---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import ArticleCard from '../../components/cards/ArticleCard.astro';
import CtaBand from '../../components/sections/CtaBand.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) => +b.data.date - +a.data.date);
const categories = [...new Set(posts.map((p) => p.data.category))];
const breadcrumbs = [
  { name: 'Accueil', href: '/' },
  { name: 'Conseils', href: '/blog/' },
];
---
<BaseLayout
  title="Conseils chambres froides, cloisons isothermes, normes HACCP"
  description="Guides pratiques pour les pros : choisir, rénover et entretenir une chambre froide, préparer un contrôle DDPP ou un audit IFS, choisir ses panneaux isothermes."
  breadcrumbs={breadcrumbs}
>
  <PageHero
    eyebrow="Conseils d’experts"
    title="Les réponses de terrain avant de lancer vos travaux"
    lead="Normes, choix techniques, budget, planning : ce qu’on explique à nos clients avant chaque chantier, écrit pour vous."
    breadcrumbs={breadcrumbs}
    ctaLabel="Poser une question à un technicien"
  />
  <section class="py-16 sm:py-20">
    <div class="container-k">
      {categories.length > 1 && (
        <ul class="mb-10 flex flex-wrap gap-2 text-sm">
          {categories.map((c) => <li class="rounded-full bg-frost-100 px-4 py-2 font-medium text-steel-600">{c}</li>)}
        </ul>
      )}
      <div class="grid gap-x-8 gap-y-14 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((p) => <ArticleCard entry={p} />)}
      </div>
    </div>
  </section>
  <CtaBand loc="blog-index" />
</BaseLayout>
