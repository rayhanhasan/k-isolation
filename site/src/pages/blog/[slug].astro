---
import { Image } from 'astro:assets';
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/sections/Breadcrumbs.astro';
import FaqList from '../../components/sections/FaqList.astro';
import CtaBand from '../../components/sections/CtaBand.astro';
import ArticleCard from '../../components/cards/ArticleCard.astro';
import Icon from '../../components/ui/Icon.astro';
import { articleSchema, faqSchema } from '../../lib/schema';
import { SITE } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const d = entry.data;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);
const words = (entry.body ?? '').split(/\s+/).length;
const minutes = d.readingTime ?? Math.max(3, Math.round(words / 220));
const fmt = (x: Date) => x.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
const service = d.ctaService ? await getEntry('services', d.ctaService.replace(/\//g, '')) : undefined;
const related = (await getCollection('blog', ({ data, id }) => !data.draft && id !== entry.id))
  .sort((a, b) => Number(b.data.category === d.category) - Number(a.data.category === d.category))
  .slice(0, 3);
const path = `/blog/${entry.id}/`;
const breadcrumbs = [
  { name: 'Accueil', href: '/' },
  { name: 'Conseils', href: '/blog/' },
  { name: d.title, href: path },
];
const schema = [
  articleSchema({ title: d.title, description: d.description, path, datePublished: d.date, dateModified: d.updated, image: d.cover?.src, author: d.author }),
  ...(d.faqs.length ? [faqSchema(d.faqs)] : []),
];
---
<BaseLayout title={d.metaTitle ?? d.title} description={d.description} breadcrumbs={breadcrumbs} image={d.cover?.src} schema={schema} ogType="article">
  <article>
    <header class="bg-frost-100 pt-10 pb-14">
      <div class="container-k max-w-4xl">
        <Breadcrumbs items={breadcrumbs} />
        <p class="mt-8 font-semibold text-brand-600">{d.category}</p>
        <h1 class="mt-3 font-display text-4xl leading-[1.1] font-extrabold text-ink sm:text-5xl">{d.title}</h1>
        <p class="mt-5 text-xl leading-relaxed text-steel-600">{d.description}</p>
        <p class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-steel-600">
          <span class="font-medium text-ink">{d.author}</span>
          <span aria-hidden="true">·</span>
          <time datetime={d.date.toISOString()}>Publié le {fmt(d.date)}</time>
          {d.updated && <><span aria-hidden="true">·</span><time datetime={d.updated.toISOString()}>Mis à jour le {fmt(d.updated)}</time></>}
          <span aria-hidden="true">·</span>
          <span>{minutes} min de lecture</span>
        </p>
      </div>
    </header>
    {d.cover && (
      <div class="container-k -mt-6 max-w-5xl">
        <Image src={d.cover} alt={d.coverAlt ?? ''} widths={[640, 960, 1280]} sizes="(min-width: 1024px) 1024px, 100vw" class="aspect-[2/1] w-full rounded-2xl object-cover shadow-card" loading="eager" fetchpriority="high" />
      </div>
    )}
    <div class="container-k grid max-w-6xl gap-12 py-14 lg:grid-cols-12">
      <div class="lg:col-span-8">
        <div class="prose-k"><Content /></div>
      </div>
      <aside class="lg:col-span-4">
        <div class="space-y-6 lg:sticky lg:top-28">
          {toc.length > 2 && (
            <nav aria-label="Sommaire" class="rounded-2xl border border-steel-200 p-5">
              <p class="font-mono text-xs tracking-wider text-steel-500 uppercase">Dans cet article</p>
              <ol class="mt-3 space-y-2 text-[0.95rem]">{toc.map((h) => <li><a href={`#${h.slug}`} class="text-steel-600 hover:text-brand-600">{h.text}</a></li>)}</ol>
            </nav>
          )}
          <div class="rounded-2xl bg-navy-900 p-6 text-white">
            <p class="font-display text-lg font-bold">{service ? service.data.cardTitle : 'Un projet en tête ?'}</p>
            <p class="mt-2 text-sm text-steel-300">{service ? service.data.cardText : 'Première estimation technique et budgétaire en moins d’un jour ouvré.'}</p>
            <a href={service ? `/devis/?besoin=${service.data.devisPreset}` : '/devis/'} data-loc={`article-${entry.id}`} class="btn-primary mt-5 w-full">Obtenir mon estimation</a>
            <a href={SITE.phoneHref} data-loc={`article-${entry.id}`} class="mt-3 flex items-center justify-center gap-2 text-sm font-semibold text-steel-300 hover:text-white"><Icon name="phone" class="size-4" /> {SITE.phone}</a>
          </div>
        </div>
      </aside>
    </div>
  </article>
  {d.faqs.length > 0 && <div class="bg-frost-50"><FaqList faqs={d.faqs} title="Questions fréquentes sur ce sujet" /></div>}
  {related.length > 0 && (
    <section class="py-16">
      <div class="container-k">
        <h2 class="h-section">À lire ensuite</h2>
        <div class="mt-10 grid gap-10 md:grid-cols-3">{related.map((p) => <ArticleCard entry={p} />)}</div>
      </div>
    </section>
  )}
  <CtaBand preset={service?.data.devisPreset} loc={`article-fin-${entry.id}`} />
</BaseLayout>
