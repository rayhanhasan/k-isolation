---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/sections/Breadcrumbs.astro';
import BeforeAfter from '../../components/sections/BeforeAfter.astro';
import CaseCard from '../../components/cards/CaseCard.astro';
import CtaBand from '../../components/sections/CtaBand.astro';
import Icon from '../../components/ui/Icon.astro';
import { SITE } from '../../data/site';

export async function getStaticPaths() {
  const all = await getCollection('realisations');
  return all.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const others = (await getCollection('realisations')).filter((c) => c.id !== entry.id).slice(0, 3);
const path = `/realisations/${entry.id}/`;
const breadcrumbs = [
  { name: 'Accueil', href: '/' },
  { name: 'Réalisations', href: '/realisations/' },
  { name: d.title, href: path },
];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.metaDescription,
  datePublished: d.date.toISOString(),
  image: new URL(d.cover.src, SITE.url).href,
  author: { '@type': 'Organization', name: SITE.name },
  about: d.service,
};
---
<BaseLayout title={d.metaTitle} description={d.metaDescription} breadcrumbs={breadcrumbs} image={d.cover.src} schema={[schema]} ogType="article">
  <section class="bg-navy-900 pt-10 pb-14 text-white">
    <div class="container-k">
      <Breadcrumbs items={breadcrumbs} dark />
      <div class="mt-8 grid gap-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-8">
          <p class="eyebrow-dark">Étude de cas · {d.sector}</p>
          <h1 class="mt-4 font-display text-4xl leading-[1.08] font-extrabold sm:text-5xl">{d.title}</h1>
          <p class="mt-5 max-w-2xl text-lg text-steel-300">{d.challenge}</p>
        </div>
        <dl class="grid grid-cols-2 gap-3 lg:col-span-4">
          <div class="rounded-xl bg-white/5 p-4"><dt class="text-xs text-steel-400">Lieu</dt><dd class="mt-1 font-semibold">{d.location}</dd></div>
          <div class="rounded-xl bg-white/5 p-4"><dt class="text-xs text-steel-400">Prestation</dt><dd class="mt-1 font-semibold">{d.service}</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section class="-mt-px bg-navy-900 pb-12">
    <div class="container-k">
      <dl class="grid grid-cols-2 gap-px overflow-hidden rounded-2xl bg-white/10 md:grid-cols-3 lg:grid-cols-6">
        {d.keyFacts.map((f) => (
          <div class="bg-navy-800 p-5 text-white">
            <dt class="text-xs text-steel-400">{f.label}</dt>
            <dd class="mt-1 font-display text-xl font-extrabold">{f.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="py-14 sm:py-20">
    <div class="container-k grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-7">
        {d.beforeAfter ? (
          <BeforeAfter before={d.beforeAfter.before} after={d.beforeAfter.after} beforeAlt={d.beforeAfter.beforeAlt} afterAlt={d.beforeAfter.afterAlt} />
        ) : (
          <Image src={d.cover} alt={d.coverAlt} widths={[640, 960, 1280]} sizes="(min-width: 1024px) 58vw, 100vw" class="aspect-[4/3] w-full rounded-2xl object-cover" loading="eager" />
        )}
        <article class="prose-k mt-12"><Content /></article>
      </div>
      <aside class="lg:col-span-5">
        <div class="space-y-6 lg:sticky lg:top-28">
          {d.gallery.length > 0 && (
            <div class="grid grid-cols-2 gap-3">
              {d.gallery.map((g) => (
                <figure>
                  <Image src={g.src} alt={g.alt} widths={[320, 640]} sizes="(min-width: 1024px) 20vw, 50vw" class="aspect-[3/4] w-full rounded-xl object-cover" />
                  {g.caption && <figcaption class="mt-1.5 text-xs text-steel-500">{g.caption}</figcaption>}
                </figure>
              ))}
            </div>
          )}
          <div class="rounded-2xl bg-frost-100 p-6">
            <p class="font-display text-lg font-bold text-ink">Un chantier comparable chez vous&nbsp;?</p>
            <p class="mt-2 text-sm text-steel-600">Décrivez vos contraintes d’exploitation : nous vous proposons un phasage adapté avec votre estimation.</p>
            <a href="/devis/" data-loc={`cas-${entry.id}`} class="btn-primary mt-5 w-full">Obtenir mon estimation</a>
            <a href={SITE.phoneHref} data-loc={`cas-${entry.id}`} class="mt-3 flex items-center justify-center gap-2 text-sm font-semibold text-ink"><Icon name="phone" class="size-4" /> {SITE.phone}</a>
          </div>
        </div>
      </aside>
    </div>
  </section>

  {others.length > 0 && (
    <section class="bg-frost-100 py-16">
      <div class="container-k">
        <h2 class="h-section">Autres réalisations</h2>
        <div class="mt-10 grid gap-6 md:grid-cols-3">{others.map((c) => <CaseCard entry={c} />)}</div>
      </div>
    </section>
  )}
  <CtaBand loc={`cas-fin-${entry.id}`} />
</BaseLayout>
