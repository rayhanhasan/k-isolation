---
import { getCollection, getEntries, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import SectionHeading from '../../components/sections/SectionHeading.astro';
import Guarantees from '../../components/sections/Guarantees.astro';
import FaqList from '../../components/sections/FaqList.astro';
import CtaBand from '../../components/sections/CtaBand.astro';
import CaseCard from '../../components/cards/CaseCard.astro';
import Icon from '../../components/ui/Icon.astro';
import { faqSchema } from '../../lib/schema';
import { inlineMd } from '../../lib/inline-md';

export async function getStaticPaths() {
  const secteurs = await getCollection('secteurs');
  return secteurs.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const cases = await getEntries(d.relatedCases);
const others = (await getCollection('secteurs')).filter((s) => s.id !== entry.id).sort((a, b) => a.data.order - b.data.order);
const path = `/secteurs/${entry.id}/`;
const breadcrumbs = [
  { name: 'Accueil', href: '/' },
  { name: 'Secteurs', href: '/#secteurs' },
  { name: d.navLabel, href: path },
];
const devisHref = `/devis/?secteur=${encodeURIComponent(d.devisPreset)}`;
---
<BaseLayout title={d.metaTitle} description={d.metaDescription} breadcrumbs={breadcrumbs} image={d.heroImage.src} schema={[faqSchema(d.faqs)]}>
  <PageHero eyebrow={d.eyebrow} title={d.h1} lead={d.lead} image={d.heroImage} imageAlt={d.heroAlt} breadcrumbs={breadcrumbs} ctaHref={devisHref} />

  {d.clientsCited.length > 0 && (
    <section class="border-b border-steel-200 bg-white py-6">
      <p class="container-k text-center text-sm text-steel-500">Ils nous ont confié des chantiers : <span class="font-semibold text-ink">{d.clientsCited.join(' · ')}</span></p>
    </section>
  )}

  <!-- Enjeux : ce que vit le lecteur -->
  <section class="py-16 sm:py-20">
    <div class="container-k">
      <SectionHeading eyebrow="Vos enjeux" title="Ce qui vous empêche de dormir avant un chantier" />
      <ul class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {d.pains.map((p) => (
          <li class="rounded-2xl border-l-4 border-alert-600/70 bg-frost-50 p-6">
            <h3 class="text-lg font-bold text-ink">{p.title}</h3>
            <p class="mt-2 leading-relaxed text-steel-600" set:html={inlineMd(p.text)} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Réponses -->
  <section class="bg-navy-900 py-16 text-white sm:py-20">
    <div class="container-k">
      <SectionHeading eyebrow="Notre réponse" title="Comment nous travaillons chez vous" dark />
      <ul class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {d.solutions.map((s) => (
          <li class="relative rounded-2xl border border-white/10 bg-white/[0.04] p-6">
            <span class="flex size-10 items-center justify-center rounded-lg bg-brand-600"><Icon name="check" class="size-5" /></span>
            <h3 class="mt-4 text-lg font-bold">{s.href ? <a href={s.href} class="after:absolute after:inset-0 hover:text-ice-300">{s.title}</a> : s.title}</h3>
            <p class="mt-2 leading-relaxed text-steel-300" set:html={inlineMd(s.text)} />
          </li>
        ))}
      </ul>
      {d.norms.length > 0 && (
        <div class="mt-10 flex flex-wrap items-center gap-2">
          <span class="mr-2 font-mono text-xs tracking-wider text-steel-400 uppercase">Référentiels maîtrisés</span>
          {d.norms.map((n) => <span class="rounded-full border border-white/15 px-3 py-1 text-sm text-steel-300">{n}</span>)}
        </div>
      )}
    </div>
  </section>

  <section class="py-16 sm:py-20">
    <div class="container-k grid gap-12 lg:grid-cols-12">
      <article class="prose-k lg:col-span-8"><Content /></article>
      <aside class="lg:col-span-4">
        <div class="rounded-2xl border border-steel-200 p-6 lg:sticky lg:top-28">
          <p class="font-display text-lg font-bold text-ink">Parlons de votre site</p>
          <p class="mt-2 text-sm text-steel-600">Dites-nous votre contrainte principale (date d’ouverture, audit, stock à protéger) : on construit le planning autour.</p>
          <a href={devisHref} data-loc={`secteur-${entry.id}`} class="btn-primary mt-5 w-full">Obtenir mon estimation</a>
          <p class="mt-6 font-mono text-xs tracking-wider text-steel-500 uppercase">Autres secteurs</p>
          <ul class="mt-3 space-y-2 text-sm">
            {others.map((o) => <li><a href={`/secteurs/${o.id}/`} class="text-steel-600 hover:text-brand-600">{o.data.navLabel}</a></li>)}
          </ul>
        </div>
      </aside>
    </div>
  </section>

  {cases.length > 0 && (
    <section class="bg-frost-100 py-16 sm:py-20">
      <div class="container-k">
        <SectionHeading eyebrow="Réalisations" title="Des chantiers dans votre secteur" />
        <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">{cases.map((c) => <CaseCard entry={c} />)}</div>
      </div>
    </section>
  )}

  <Guarantees />
  <div class="bg-frost-50"><FaqList faqs={d.faqs} /></div>
  <CtaBand href={devisHref} loc={`secteur-fin-${entry.id}`} />
</BaseLayout>
