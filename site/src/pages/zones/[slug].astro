---
import { getCollection, getEntries, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import SectionHeading from '../../components/sections/SectionHeading.astro';
import FaqList from '../../components/sections/FaqList.astro';
import CtaBand from '../../components/sections/CtaBand.astro';
import CaseCard from '../../components/cards/CaseCard.astro';
import Icon from '../../components/ui/Icon.astro';
import { SERVICES_NAV } from '../../data/site';
import { faqSchema } from '../../lib/schema';
import { inlineMd } from '../../lib/inline-md';

export async function getStaticPaths() {
  const zones = await getCollection('zones');
  return zones.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const cases = await getEntries(d.relatedCases);
const path = `/zones/${entry.id}/`;
const breadcrumbs = [
  { name: 'Accueil', href: '/' },
  { name: 'Zones d’intervention', href: '/zones/' },
  { name: d.name, href: path },
];
---
<BaseLayout title={d.metaTitle} description={d.metaDescription} breadcrumbs={breadcrumbs} schema={d.faqs.length ? [faqSchema(d.faqs)] : []}>
  <PageHero eyebrow={`Intervention · ${d.name}`} title={d.h1} lead={d.lead} image={d.heroImage} imageAlt={d.heroAlt} breadcrumbs={breadcrumbs} />

  <section class="py-16 sm:py-20">
    <div class="container-k">
      <SectionHeading eyebrow="Le terrain" title={`Ce qui compte pour un chantier en ${d.name}`} />
      <ul class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {d.localContext.map((c) => (
          <li class="card p-6">
            <h3 class="flex items-center gap-2 text-lg font-bold text-ink"><Icon name="mapPin" class="size-5 text-brand-600" />{c.title}</h3>
            <p class="mt-2 leading-relaxed text-steel-600" set:html={inlineMd(c.text)} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="bg-frost-100 py-16 sm:py-20">
    <div class="container-k grid gap-12 lg:grid-cols-12">
      <article class="prose-k lg:col-span-8"><Content /></article>
      <aside class="space-y-6 lg:col-span-4">
        {d.areas.length > 0 && (
          <div class="card p-6">
            <p class="font-mono text-xs tracking-wider text-steel-500 uppercase">Secteurs desservis</p>
            <ul class="mt-3 flex flex-wrap gap-2">{d.areas.map((a) => <li class="rounded-full bg-frost-100 px-3 py-1 text-sm text-steel-600">{a}</li>)}</ul>
          </div>
        )}
        <div class="card p-6">
          <p class="font-mono text-xs tracking-wider text-steel-500 uppercase">Nos solutions</p>
          <ul class="mt-3 space-y-2">{SERVICES_NAV.map((s) => <li><a href={s.href} class="link-arrow text-[0.95rem]">{s.label}</a></li>)}</ul>
        </div>
      </aside>
    </div>
  </section>

  {cases.length > 0 && (
    <section class="py-16">
      <div class="container-k">
        <SectionHeading eyebrow="Références locales" title="Chantiers réalisés dans la zone" />
        <div class="mt-10 grid gap-6 md:grid-cols-3">{cases.map((c) => <CaseCard entry={c} />)}</div>
      </div>
    </section>
  )}
  {d.faqs.length > 0 && <div class="bg-frost-50"><FaqList faqs={d.faqs} /></div>}
  <CtaBand loc={`zone-${entry.id}`} />
</BaseLayout>
