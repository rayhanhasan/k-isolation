---
import Logo from '../ui/Logo.astro';
import Icon from '../ui/Icon.astro';
import { SITE, SERVICES_NAV, SECTORS_NAV } from '../../data/site';
import { ZONES_FOOTER } from '../../data/zones-nav';

const year = new Date().getFullYear();
const company = [
  { label: 'Réalisations', href: '/realisations/' },
  { label: 'Conseils & guides', href: '/blog/' },
  { label: 'À propos', href: '/a-propos/' },
  { label: 'Questions fréquentes', href: '/faq/' },
  { label: 'Recrutement', href: '/recrutement/' },
  { label: 'Contact', href: '/contact/' },
];
---
<footer class="bg-navy-950 text-steel-400">
  <div class="container-k grid gap-12 py-16 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <Logo variant="light" />
      <p class="mt-5 max-w-sm leading-relaxed">
        Conception, pose, rénovation et maintenance de chambres froides, cloisons isothermes et salles blanches pour les professionnels.
      </p>
      <address class="mt-6 space-y-2.5 not-italic">
        <a href={SITE.phoneHref} data-loc="footer" class="flex items-center gap-2.5 font-semibold text-white hover:text-ice-300"><Icon name="phone" class="size-4" /> {SITE.phone}</a>
        <a href={`mailto:${SITE.email}`} data-loc="footer" class="flex items-center gap-2.5 hover:text-white"><Icon name="mail" class="size-4" /> {SITE.email}</a>
        <p class="flex items-start gap-2.5"><Icon name="mapPin" class="mt-0.5 size-4 shrink-0" /> {SITE.address.street}, {SITE.address.postalCode} {SITE.address.city}</p>
      </address>
      <a href="/devis/" data-loc="footer" class="btn-primary mt-7">Demander un devis gratuit</a>
    </div>

    <div class="grid gap-10 sm:grid-cols-2 lg:col-span-8 lg:grid-cols-4">
      <div>
        <p class="font-display text-sm font-bold tracking-wide text-white uppercase">Solutions</p>
        <ul class="mt-4 space-y-2.5 text-[0.95rem]">
          {SERVICES_NAV.map((s) => <li><a href={s.href} class="hover:text-white">{s.label}</a></li>)}
        </ul>
      </div>
      <div>
        <p class="font-display text-sm font-bold tracking-wide text-white uppercase">Secteurs</p>
        <ul class="mt-4 space-y-2.5 text-[0.95rem]">
          {SECTORS_NAV.map((s) => <li><a href={s.href} class="hover:text-white">{s.label}</a></li>)}
        </ul>
      </div>
      <div>
        <p class="font-display text-sm font-bold tracking-wide text-white uppercase">Zones</p>
        <ul class="mt-4 space-y-2.5 text-[0.95rem]">
          {ZONES_FOOTER.map((z) => <li><a href={z.href} class="hover:text-white">{z.label}</a></li>)}
        </ul>
      </div>
      <div>
        <p class="font-display text-sm font-bold tracking-wide text-white uppercase">Entreprise</p>
        <ul class="mt-4 space-y-2.5 text-[0.95rem]">
          {company.map((s) => <li><a href={s.href} class="hover:text-white">{s.label}</a></li>)}
          <li><a href={SITE.linkedin} rel="noopener" target="_blank" class="inline-flex items-center gap-2 hover:text-white"><Icon name="linkedin" class="size-4" /> LinkedIn</a></li>
        </ul>
      </div>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="container-k flex flex-col gap-3 py-6 text-sm sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {SITE.legalName} — SIREN {SITE.siren} — {SITE.rcs}</p>
      <ul class="flex flex-wrap gap-x-5 gap-y-2">
        <li><a href="/mentions-legales/" class="hover:text-white">Mentions légales</a></li>
        <li><a href="/confidentialite/" class="hover:text-white">Confidentialité</a></li>
        <li><a href="/plan-du-site/" class="hover:text-white">Plan du site</a></li>
      </ul>
    </div>
  </div>
</footer>
