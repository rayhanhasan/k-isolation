---
import Icon from '../ui/Icon.astro';
import { SITE } from '../../data/site';
interface Props {
  title?: string;
  text?: string;
  preset?: string;
  /** Lien complet vers le formulaire (prioritaire sur preset) */
  href?: string;
  loc?: string;
}
const {
  title = 'Votre projet mérite un devis clair, chiffré, sans mauvaise surprise.',
  text = 'Décrivez votre besoin en 2 minutes. Un technicien vous rappelle, organise la visite si nécessaire et vous remet un devis détaillé poste par poste.',
  preset,
  href: hrefProp,
  loc = 'cta-band',
} = Astro.props;
const href = hrefProp ?? (preset ? `/devis/?besoin=${encodeURIComponent(preset)}` : '/devis/');
---
<section class="py-16 sm:py-20">
  <div class="container-k">
    <div class="relative overflow-hidden rounded-3xl bg-navy-900 px-6 py-12 text-white sm:px-12 sm:py-16">
      <div class="bg-blueprint absolute inset-0" aria-hidden="true"></div>
      <div class="absolute -bottom-32 -left-24 size-96 rounded-full bg-brand-600/30 blur-3xl" aria-hidden="true"></div>
      <div class="relative grid items-center gap-10 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <h2 class="font-display text-3xl leading-tight font-extrabold sm:text-4xl">{title}</h2>
          <p class="mt-4 max-w-xl text-lg text-steel-300">{text}</p>
        </div>
        <div class="lg:col-span-5">
          <div class="flex flex-col gap-3 sm:flex-row lg:flex-col">
            <a href={href} data-loc={loc} class="btn-primary w-full text-lg">Obtenir mon devis gratuit <Icon name="arrowRight" class="size-5" /></a>
            <a href={SITE.phoneHref} data-loc={loc} class="btn-ghost-dark w-full"><Icon name="phone" class="size-5" /> Parler à un technicien : {SITE.phone}</a>
          </div>
          <ul class="mt-5 grid gap-2 text-sm text-steel-300 sm:grid-cols-3 lg:grid-cols-1">
            <li class="flex items-center gap-2"><Icon name="check" class="size-4 text-ice-400" /> Réponse sous {SITE.responseTime}</li>
            <li class="flex items-center gap-2"><Icon name="check" class="size-4 text-ice-400" /> Sans engagement, sans relance commerciale</li>
            <li class="flex items-center gap-2"><Icon name="check" class="size-4 text-ice-400" /> Travaux couverts par la garantie décennale</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
