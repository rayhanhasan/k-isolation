---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { CLIENTS } from '../../data/site';

interface Props {
  title?: string;
  dark?: boolean;
}
const { title = 'Ils nous ont confié leurs sites', dark = false } = Astro.props;
const files = import.meta.glob<{ default: ImageMetadata }>('../../assets/logos/*.{png,svg}', { eager: true });
const logoOf = (f: string) => files[`../../assets/logos/${f}`]?.default;
---
<div class="container-k">
  <div class="flex flex-col items-center gap-6 lg:flex-row lg:gap-10">
    <p class:list={['shrink-0 text-center font-mono text-xs tracking-[0.14em] uppercase lg:max-w-[11rem] lg:text-left', dark ? 'text-steel-400' : 'text-steel-500']}>{title}</p>
    <ul class="grid w-full grid-cols-4 items-center gap-x-6 gap-y-6 sm:grid-cols-7">
      {CLIENTS.map((c) => {
        const img = logoOf(c.logo);
        return (
          <li class="flex h-12 items-center justify-center" title={`${c.name} — ${c.sector}`}>
            {img ? (
              <Image
                src={img}
                alt={c.name}
                height={48}
                class:list={['max-h-11 w-auto object-contain opacity-70 grayscale transition hover:opacity-100 hover:grayscale-0', dark && 'brightness-0 invert opacity-60']}
              />
            ) : (
              <span class="font-display font-bold text-steel-500">{c.name}</span>
            )}
          </li>
        );
      })}
    </ul>
  </div>
</div>
