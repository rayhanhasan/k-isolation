---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  before: ImageMetadata;
  after: ImageMetadata;
  beforeAlt: string;
  afterAlt: string;
  class?: string;
}
const { before, after, beforeAlt, afterAlt, class: className = '' } = Astro.props;
// Format paysage commun : on recadre les deux images au même ratio
const [b, a] = await Promise.all([
  getImage({ src: before, width: 1200, height: 900, fit: 'cover', format: 'webp' }),
  getImage({ src: after, width: 1200, height: 900, fit: 'cover', format: 'webp' }),
]);
---
<figure class:list={['ba-slider relative isolate aspect-[4/3] w-full overflow-hidden rounded-2xl bg-navy-900 select-none', className]} style="--pos: 50%">
  <img src={a.src} alt={afterAlt} class="absolute inset-0 size-full object-cover" loading="lazy" decoding="async" width="1200" height="900" />
  <div class="absolute inset-0 [clip-path:inset(0_calc(100%-var(--pos))_0_0)]">
    <img src={b.src} alt={beforeAlt} class="size-full object-cover" loading="lazy" decoding="async" width="1200" height="900" />
  </div>
  <span class="absolute top-3 left-3 rounded-full bg-navy-950/80 px-3 py-1 font-mono text-xs tracking-wider text-white uppercase">Avant</span>
  <span class="absolute top-3 right-3 rounded-full bg-brand-600 px-3 py-1 font-mono text-xs tracking-wider text-white uppercase">Après</span>
  <div class="pointer-events-none absolute inset-y-0 left-[var(--pos)] w-0.5 -translate-x-1/2 bg-white shadow-[0_0_0_1px_rgb(0_0_0/0.2)]">
    <span class="absolute top-1/2 left-1/2 flex size-10 -translate-1/2 items-center justify-center rounded-full bg-white text-ink shadow-lift">
      <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18-6-6 6-6M15 6l6 6-6 6" /></svg>
    </span>
  </div>
  <input type="range" min="0" max="100" value="50" aria-label="Comparer avant et après" class="absolute inset-0 size-full cursor-ew-resize opacity-0" />
</figure>
<script>
  document.querySelectorAll<HTMLElement>('.ba-slider').forEach((el) => {
    const input = el.querySelector('input');
    input?.addEventListener('input', () => el.style.setProperty('--pos', `${input.value}%`));
  });
</script>
