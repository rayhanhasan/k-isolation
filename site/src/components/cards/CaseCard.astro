---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Icon from '../ui/Icon.astro';
interface Props {
  entry: CollectionEntry<'realisations'>;
  headingLevel?: 'h2' | 'h3';
}
const { entry, headingLevel = 'h3' } = Astro.props;
const d = entry.data;
const H = headingLevel;
---
<article class="group card relative flex flex-col overflow-hidden transition hover:-translate-y-1 hover:shadow-lift">
  <div class="relative overflow-hidden">
    <Image src={d.cover} alt={d.coverAlt} widths={[400, 640, 800]} sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw" class="aspect-[4/3] w-full object-cover transition duration-500 group-hover:scale-[1.03]" />
    <span class="absolute top-3 left-3 rounded-full bg-white/95 px-3 py-1 text-xs font-semibold text-ink shadow">{d.sector}</span>
  </div>
  <div class="flex flex-1 flex-col p-6">
    <p class="flex items-center gap-1.5 text-sm text-steel-500"><Icon name="mapPin" class="size-3.5" /> {d.location}</p>
    <H class="mt-2 text-lg leading-snug font-bold text-ink">
      <a href={`/realisations/${entry.id}/`} class="after:absolute after:inset-0">{d.title}</a>
    </H>
    <dl class="mt-4 grid grid-cols-2 gap-3 border-t border-steel-200 pt-4">
      {d.keyFacts.slice(0, 2).map((f) => (
        <div>
          <dt class="text-xs text-steel-500">{f.label}</dt>
          <dd class="font-display font-bold text-ink">{f.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</article>
